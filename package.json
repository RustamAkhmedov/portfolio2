{
  "name": "portfolio-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "shots": "node tools/shot.mjs",
    "shots:demo": "node tools/demo-shot.mjs",
    "shots:modes": "node tools/shot.mjs --mode reduced && node tools/shot.mjs --mode no-webgl --no-build && node tools/shot.mjs --mode no-js --no-build",
    "still": "node tools/shot.mjs --still",
    "scroll-shots": "node tools/scroll-shot.mjs",
    "perf": "node tools/perf.mjs",
    "bundle": "node tools/bundle.mjs",
    "brand": "node tools/brand.mjs",
    "cv-preview": "node tools/cv-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
